GEMINI_SUMMARIZATION_MODEL=replace-with-supported-gemini-model
GEMINI_VISION_MODEL=replace-with-supported-gemini-model
GROQ_API_KEY=
GROQ_MODEL=replace-with-supported-groq-text-model
GROQ_EXTRACTION_MODEL=replace-with-supported-groq-text-model
GROQ_SUMMARIZATION_MODEL=replace-with-supported-groq-text-model
GROQ_VISION_MODEL=replace-with-supported-groq-vision-model
